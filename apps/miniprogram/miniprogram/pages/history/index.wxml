<view class="history-shell">
  <view class="history-header">
    <text class="history-title">上传记录</text>
    <text class="history-subtitle">这里只展示素材传到服务器的状态。</text>
  </view>

  <view class="history-toolbar" wx:if="{{records.length}}">
    <button
      class="clear-history-button"
      bindtap="onClearUploadedHistory"
      loading="{{clearingUploaded}}"
      disabled="{{clearingUploaded}}"
    >
      {{clearingUploaded ? '正在清空' : '清空已上传记录'}}
    </button>
  </view>

  <view class="history-empty" wx:if="{{!loading && watchingForNewUpload && !records.length && !error}}">
    <text class="empty-title">正在创建上传任务</text>
    <text class="empty-copy">素材已交给上传服务，记录将在这里自动出现。</text>
  </view>

  <view class="history-empty" wx:if="{{!loading && !watchingForNewUpload && !records.length && !error}}">
    <text class="empty-title">还没有上传记录</text>
    <text class="empty-copy">完成一次素材上传后，记录会显示在这里。</text>
  </view>

  <view class="history-list" wx:if="{{records.length}}">
    <view class="history-item" wx:for="{{records}}" wx:key="id" wx:for-item="item">
      <view class="item-heading">
        <text class="item-name">{{item.fileName}}</text>
        <view class="item-actions">
          <text class="status-pill tone-{{item.tone}}">{{item.statusLabel}}</text>
          <button
            wx:if="{{item.cancellable}}"
            class="cancel-upload-button"
            aria-label="取消上传 {{item.fileName}}"
            data-upload-id="{{item.id}}"
            bindtap="onCancelUpload"
          >
            取消
          </button>
        </view>
      </view>
      <text class="item-meta">{{item.kindLabel}} · {{item.sizeLabel}}</text>
      <view class="history-progress" wx:if="{{!item.terminal}}">
        <view class="history-progress-fill" style="width: {{item.percent}}%;"></view>
      </view>
      <view class="progress-row" wx:if="{{!item.terminal}}">
        <text>传到服务器</text>
        <text>{{item.percent}}%</text>
      </view>
      <text class="failure-copy" wx:if="{{item.failureMessage}}">{{item.failureMessage}}</text>
      <view class="record-actions" wx:if="{{item.terminal}}">
        <button
          wx:if="{{item.retryable || item.retryPending}}"
          class="retry-upload-button"
          aria-label="重新上传 {{item.fileName}}"
          data-upload-id="{{item.id}}"
          bindtap="onRetryUpload"
          loading="{{item.retryPending}}"
          disabled="{{item.retryPending}}"
        >
          {{item.retryPending ? '重试中' : '↻ 重新上传'}}
        </button>
        <button
          wx:if="{{item.deletable || item.deletePending}}"
          class="delete-record-button"
          aria-label="删除记录 {{item.fileName}}"
          data-upload-id="{{item.id}}"
          bindtap="onDeleteRecord"
          loading="{{item.deletePending}}"
          disabled="{{item.deletePending}}"
        >
          删除记录
        </button>
      </view>
      <text class="time-copy">创建于 {{item.createdAtLabel}} · 更新于 {{item.updatedAtLabel}}</text>
    </view>
  </view>

  <text class="loading-copy" wx:if="{{loading || refreshing}}">正在加载记录…</text>
  <text class="loading-copy" wx:if="{{loadingMore}}">正在加载更多…</text>
  <text class="end-copy" wx:if="{{records.length && !hasMore && !loading}}">没有更多记录了</text>
  <text class="error-copy" wx:if="{{error}}">{{error}}</text>
</view>
