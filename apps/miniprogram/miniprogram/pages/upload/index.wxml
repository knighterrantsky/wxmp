<view class="page-shell">
  <view class="hero-card">
    <text class="eyebrow">PRIVATE MEDIA</text>
    <text class="title">私密素材上传</text>
    <text class="subtitle">图片与视频将通过你的专属账号上传到私有存储，不提供公开访问。</text>
  </view>

  <view class="card {{nicknameConfirmed ? 'confirmed-card' : ''}}">
    <block wx:if="{{nicknameConfirmed}}">
      <view class="confirmed-profile-row">
        <view class="confirmed-profile-copy">
          <text class="profile-label">当前上传用户</text>
          <text class="confirmed-name">{{nickname}}</text>
        </view>
        <button
          wx:if="{{!nicknameEditing && !nicknamePrivacyPromptVisible}}"
          class="nickname-edit-button"
          bindtap="onRequestNicknamePrivacy"
        >
          修改昵称
        </button>
      </view>
    </block>
    <block wx:else>
      <text class="section-title">先确认微信昵称</text>
      <text class="help-text">昵称用于标识你上传的素材，仅作为显示名称，不代表实名认证。授权后，请点击昵称输入框，并在键盘上方选择微信昵称；微信不会自动填入。</text>
    </block>

    <button
      wx:if="{{!nicknameConfirmed && !nicknamePrivacyAuthorized && !nicknamePrivacyPromptVisible}}"
      class="primary-button"
      bindtap="onRequestNicknamePrivacy"
      loading="{{nicknamePrivacyRequesting}}"
      disabled="{{nicknamePrivacyRequesting}}"
    >
      申请微信昵称授权
    </button>
    <view class="privacy-panel" wx:if="{{nicknamePrivacyPromptVisible}}">
      <text class="privacy-title">微信昵称使用授权</text>
      <text class="help-text">同意后才会启用微信昵称输入能力；暂不授权不会保存本次昵称。首次使用时，开始上传前仍需确认昵称。</text>
      <button class="privacy-contract-button" bindtap="onOpenNicknamePrivacyContract">
        查看隐私保护指引
      </button>
      <button
        id="nickname-privacy-agree"
        class="primary-button"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreeNicknamePrivacy"
      >
        同意隐私指引并继续
      </button>
      <button class="privacy-cancel-button" bindtap="onRejectNicknamePrivacy">
        暂不授权
      </button>
    </view>

    <view wx:if="{{nicknamePrivacyAuthorized && (!nicknameConfirmed || nicknameEditing)}}">
      <form bindsubmit="onConfirmNickname">
        <input
          class="nickname-input {{nicknameConfirmed ? 'compact' : ''}}"
          name="nickname"
          type="nickname"
          value="{{nicknameDraft}}"
          placeholder="{{nicknameConfirmed ? '重新选择微信昵称' : '点击后在键盘上方选择昵称'}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameReviewStart"
          bindnicknamereview="onNicknameReview"
        />
        <button
          wx:if="{{!nicknameConfirmed}}"
          class="primary-button"
          form-type="submit"
          loading="{{nicknameSaving}}"
          disabled="{{nicknameSaving}}"
        >
          确认使用此昵称
        </button>
        <button
          wx:else
          class="secondary-button"
          form-type="submit"
          loading="{{nicknameSaving}}"
          disabled="{{nicknameSaving}}"
        >
          确认更新昵称
        </button>
      </form>
      <text class="notice-text" wx:if="{{nicknameReviewPending}}">微信正在审核昵称，审核通过后才会保存。</text>
    </view>
    <text class="error-text" wx:if="{{nicknameError}}">{{nicknameError}}</text>
  </view>

  <view class="card upload-card">
    <text class="section-title">上传素材</text>
    <text class="help-text">支持图片和视频，单个文件不超过 200MB。选择后可预览和修改，点击上传即表示确认。</text>
    <button
      wx:if="{{!selectedFiles.length}}"
      class="upload-button"
      bindtap="onChooseMedia"
      loading="{{draftPicking}}"
      disabled="{{nicknamePrivacyPromptVisible || nicknamePrivacyRequesting || draftPicking || draftSubmitting}}"
    >
      {{draftPicking ? '正在打开选择器' : '选择图片或视频'}}
    </button>
    <text class="notice-text" wx:if="{{!nicknameConfirmed}}">可以先选择素材；开始上传前仍需确认昵称。</text>
    <view class="selection-panel" wx:if="{{selectedFiles.length}}">
      <view class="selection-summary">
        <view>
          <text class="selection-title">上传预览</text>
          <text class="selection-total">{{selectedFiles.length}} 个文件 · {{selectedTotalLabel}}</text>
        </view>
        <button
          class="reselect-button"
          aria-label="继续添加图片或视频"
          bindtap="onChooseMedia"
          loading="{{draftPicking}}"
          disabled="{{draftPicking || draftSubmitting}}"
        >
          {{draftPicking ? '选择中' : '继续添加'}}
        </button>
      </view>
      <view
        class="selected-file"
        wx:for="{{selectedFiles}}"
        wx:key="id"
        wx:for-item="item"
        wx:for-index="index"
      >
        <view class="preview-frame">
          <image
            wx:if="{{item.hasThumbnail}}"
            class="preview-image"
            src="{{item.previewPath}}"
            mode="aspectFill"
          />
          <view class="video-placeholder" wx:else>视频</view>
          <text class="video-badge" wx:if="{{item.isVideo}}">视频</text>
        </view>
        <view class="selected-file-copy">
          <view class="file-name-editor">
            <input
              class="file-name-input"
              value="{{item.fileNameStem}}"
              maxlength="240"
              aria-label="修改 {{item.fileName}} 的文件名"
              data-index="{{index}}"
              bindinput="onRenameSelectedMedia"
              disabled="{{draftPicking || draftSubmitting}}"
            />
            <text class="file-extension">{{item.fileExtension}}</text>
          </view>
          <text class="selected-file-meta">{{item.kindLabel}} · {{item.sizeLabel}}</text>
        </view>
        <button
          class="remove-file-button"
          aria-label="移除 {{item.fileName}}"
          data-index="{{index}}"
          catchtap="onRemoveSelectedMedia"
          disabled="{{draftPicking || draftSubmitting}}"
        >
          移除
        </button>
      </view>
      <button
        class="primary-button start-upload-button"
        bindtap="onStartSelectedUpload"
        loading="{{draftSubmitting}}"
        disabled="{{draftPicking || draftSubmitting || nicknameSaving}}"
      >
        {{draftSubmitting ? '正在创建上传任务' : (nicknameConfirmed ? '上传 ' + selectedFiles.length + ' 个素材' : '请先确认昵称后上传')}}
      </button>
    </view>
    <text class="error-text" wx:if="{{selectionError}}">{{selectionError}}</text>
  </view>

  <button class="history-button" bindtap="onOpenHistory">查看我的上传记录</button>
</view>
