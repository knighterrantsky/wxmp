page {
  min-height: 100%;
  background: #f3f6f4;
  color: #18332b;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.hero-card,
.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(28, 74, 59, 0.1);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(27, 65, 52, 0.07);
}

.hero-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding: 40rpx 36rpx;
  background: linear-gradient(145deg, #173d32 0%, #28654f 100%);
  color: #ffffff;
}

.eyebrow {
  margin-bottom: 14rpx;
  color: #a9e5c9;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.7;
}

.card {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding: 34rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 650;
}

.help-text,
.notice-text {
  margin-top: 14rpx;
  color: #61746d;
  font-size: 25rpx;
  line-height: 1.65;
}

form {
  display: flex;
  width: 100%;
  flex-direction: column;
}

.privacy-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #cbd8d2;
  border-radius: 18rpx;
  background: #f8faf9;
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 650;
}

.privacy-contract-button {
  width: 100%;
  margin-top: 16rpx;
  border: 2rpx solid #1f6b50;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1f6b50;
  font-size: 26rpx;
}

.nickname-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0 26rpx;
  border: 2rpx solid #cbd8d2;
  border-radius: 18rpx;
  background: #f8faf9;
  font-size: 29rpx;
}

.nickname-input.compact {
  margin-top: 22rpx;
}

.primary-button,
.secondary-button,
.upload-button {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.primary-button,
.upload-button {
  background: #1f6b50;
  color: #ffffff;
}

.secondary-button {
  border: 2rpx solid #1f6b50;
  background: #ffffff;
  color: #1f6b50;
}

.privacy-cancel-button {
  width: 100%;
  margin-top: 16rpx;
  border: 0;
  background: transparent;
  color: #61746d;
  font-size: 26rpx;
}

.confirmed-card {
  border-color: rgba(31, 107, 80, 0.22);
  padding-top: 26rpx;
  padding-bottom: 26rpx;
}

.confirmed-profile-row,
.selection-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.confirmed-profile-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.profile-label {
  color: #61746d;
  font-size: 22rpx;
}

.confirmed-name {
  margin-top: 6rpx;
  color: #1f6b50;
  font-size: 32rpx;
  font-weight: 700;
}

.nickname-edit-button,
.reselect-button,
.remove-file-button {
  margin: 0;
  border: 0;
  background: transparent;
  color: #1f6b50;
}

.nickname-edit-button::after,
.reselect-button::after,
.remove-file-button::after,
.privacy-cancel-button::after,
.history-button::after {
  border: 0;
}

.nickname-edit-button {
  width: auto;
  padding: 12rpx 8rpx 12rpx 24rpx;
  font-size: 24rpx;
}

.upload-card {
  margin-bottom: 0;
}

.upload-button {
  height: 96rpx;
  margin-top: 30rpx;
}

.notice-text {
  color: #9a6c22;
}

.error-text {
  margin-top: 16rpx;
  color: #b3463c;
  font-size: 24rpx;
}

.selection-panel {
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e4ebe7;
}

.selection-title {
  display: block;
  color: #18332b;
  font-size: 27rpx;
  font-weight: 650;
}

.selection-total {
  display: block;
  margin-top: 6rpx;
  color: #61746d;
  font-size: 24rpx;
}

.reselect-button {
  width: auto;
  padding: 12rpx 0 12rpx 24rpx;
  font-size: 24rpx;
}

.selected-file {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f6f9f7;
}

.preview-frame {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex: 0 0 144rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #dfe8e3;
}

.preview-image,
.video-placeholder {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 14rpx;
}

.video-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #61746d;
  font-size: 24rpx;
}

.video-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(16, 42, 34, 0.78);
  color: #ffffff;
  font-size: 18rpx;
}

.remove-file-button {
  width: auto;
  min-width: 88rpx;
  margin-left: 12rpx;
  padding: 18rpx 0 18rpx 16rpx;
  color: #8b514b;
  font-size: 23rpx;
  line-height: 1.2;
}

.remove-file-button[disabled],
.reselect-button[disabled] {
  opacity: 0.45;
}

.selected-file-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 24rpx;
}

.file-name-editor {
  display: flex;
  min-width: 0;
  align-items: center;
}

.file-name-input {
  min-width: 0;
  flex: 1;
  height: 58rpx;
  padding: 0 14rpx;
  border: 1rpx solid #cfdcd5;
  border-radius: 10rpx 0 0 10rpx;
  background: #ffffff;
  color: #18332b;
  font-size: 24rpx;
  font-weight: 600;
}

.file-extension {
  box-sizing: border-box;
  height: 58rpx;
  padding: 0 12rpx;
  border: 1rpx solid #cfdcd5;
  border-left: 0;
  border-radius: 0 10rpx 10rpx 0;
  background: #edf3ef;
  color: #61746d;
  font-size: 22rpx;
  line-height: 56rpx;
}

.selected-file-meta {
  display: block;
  margin-top: 10rpx;
  color: #71817b;
  font-size: 22rpx;
}

.start-upload-button {
  margin-top: 24rpx;
}

.history-button {
  width: 100%;
  margin-top: 22rpx;
  border: 0;
  background: transparent;
  color: #1f6b50;
  font-size: 26rpx;
}
